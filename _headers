# ==============================================================================
# PROJECT MAANYATA — CLOUDFLARE PAGES HTTP HEADERS CONFIGURATION
# ==============================================================================

# Global Security & Device Hardware Access Rules
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), geolocation=(self), microphone=(), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# HTML Deliverables — Immediate freshness for active housing society ground pilot
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/html; charset=utf-8

# Core Local-First Persistence DAO
/maanyata_store.js
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/javascript; charset=utf-8

# Static Pure-JS QR Scanner Engine (Immutable Vendor Asset)
/jsQR.js
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript; charset=utf-8

# Evidentiary Screen Audits & Image Captures
/evidence/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
